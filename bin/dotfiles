#!/bin/bash
#
# `dotfiles` handles installation, updates, things like that. Run it periodically to make sure you're on the latest and greatest.

set -e

parentDirectory="$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd -P)"
dotfilesDirectory="$(cd "$( dirname "${parentDirectory}" )" && pwd -P)"

source "${dotfilesDirectory}/system/logging.sh"

bold=$(tput bold)
normal=$(tput sgr0)

displayUsageAndExit() {
	echo "${bold}dotfiles -- dotfiles management${normal}"
	echo ""
	echo "${bold}Usage:${normal} dotfiles [subcommand] [arguments and options]."
	echo ""
	echo "${bold}Subcommands:${normal}"
	echo "  add     Adds a symlink for a file or directory to the dotfiles directory"
	echo "  check   Checks the status of dotfiles (git, packages, symlinks, etc.)"
	echo "  edit    Opens dotfiles directory for editing"
	echo "  git     Runs git in the dotfiles directory without changing current working directory"
	echo "  sync    Installs and uninstalls Homebrew packages so that they exactly match the Brewfile"
	echo ""
	echo "If no options are specified, the command will default to check."
	echo ""
	echo "${bold}Global Options:${normal}"
	echo "  -c, --command-line-sudo-askpass  Use command line prompt to ask for sudo password"
	echo "  -d, --defaults                   Set defaults"
	echo "  -h, --help                       Show this help message and exit"
	echo "  -i, --install                    Install dependencies"
	echo "  -l, --link                       Link dotfiles into the proper place"
	exit
}

displayAddUsageAndExit() {
	echo "${bold}Add subcommand:${normal} Adds a symlink for a file or directory to the dotfiles directory"
	echo ""
	echo "Usage: dotfiles add <path> [options]"
	echo ""
	echo "Arguments:"
	echo "  path: The path to add to the dotfiles directory"
	exit
}

displayCheckUsageAndExit() {
	echo "${bold}Check subcommand:${normal} Checks the status of dotfiles (git, packages, symlinks, etc.)"
	echo ""
	echo "Usage: dotfiles check"
	exit
}

displayEditUsageAndExit() {
	echo "${bold}Edit subcommand:${normal} Opens dotfiles directory for editing"
	echo ""
	echo "Usage: dotfiles edit"
	exit
}

displayGitUsageAndExit() {
	echo "${bold}Git subcommand:${normal} Runs git in the dotfiles directory without changing current working directory"
	echo ""
	echo "Usage: dotfiles git [git arguments and options]"
	exit
}

displaySyncUsageAndExit() {
	echo "${bold}Sync subcommand:${normal} Installs and uninstalls Homebrew packages so that they exactly match the Brewfile"
	echo ""
	echo "Usage: dotfiles sync"
	exit
}

# ------------------------------------------------------------------------------
# Help subcommand
# ------------------------------------------------------------------------------

if [[ "${1}" == "help" ]]; then
    case "${2}" in
        "add")
            displayAddUsageAndExit
            ;;
        "check")
            displayCheckUsageAndExit
            ;;
        "edit")
            displayEditUsageAndExit
            ;;
        "git")
            displayGitUsageAndExit
            ;;
        "sync")
            displaySyncUsageAndExit
            ;;
        *)
            displayUsageAndExit
            ;;
    esac
fi

# ------------------------------------------------------------------------------
# Add subcommand
# ------------------------------------------------------------------------------

if [[ "${1}" == "add" ]]; then
    if [[ "${2}" == "-h" || "${2}" == "--help" ]]; then
        displayAddUsageAndExit
    fi
    if [[ ! -e "${2}" ]]; then
        echo "Error: Could not find path: ${2}"
        exit 1
    fi

    if [[ "${2}" == /* ]]; then
        # Absolute path
        path="${2}"
    else
        # Relative path
        path="$(pwd)/${2}"
    fi

    if [[ ! "${path}" == "${HOME}"/* ]]; then
        echo "Error: Path is not within home directory: ${2}"
        exit 1
    fi

    iteratorPath="${path}"
    pathSegments=()
    while [[ "${iteratorPath}" != "${HOME}" ]]; do
      if [[ -L "${iteratorPath}" ]]; then
        echo "Error: ${iteratorPath} is already a symlink"
        exit 1
      fi
      pathSegments+=("${iteratorPath}")
      iteratorPath="$(dirname "${iteratorPath}")"
    done

    cd "${dotfilesDirectory}"
    options=()
    for directory in */; do
        if [[ "${directory}" != "bin/" ]]; then
            options+=("$(basename ${directory})")
        fi
    done
    newPackage="<New package>"
    options+=("${newPackage}")

    echo "${options[@]}"

    select package in "${options[@]}"; do
        [[ -n "${package}" ]] && break
        echo ">>> Invalid Selection"
    done

    if [[ "${package}" == "${newPackage}" ]]; then
        while true; do
            read -p "What should be the name of the new package? " package
            if [[ "${package}" == *\/* || "${package}" == *\\* ]]; then
                echo "Package name cannot have a forward slash or a backward slash"
            elif [[ -z "${package}" ]]; then
                continue
            else
                break
            fi
        done
    fi

    echo "will add to this package: ${package}"

    prefix="${dotfilesDirectory}/${package}"

    mkdir -p "${prefix}"

    for (( i=${#pathSegments[@]}-1 ; i>=1 ; i-- )) ; do
        # Need to remove the leading dot due to assumptions made in link.sh
        part="$(basename "${pathSegments[i]}")"
        prefix="${prefix}/${part#.}.symlinkParent"
        mkdir -p "${prefix}"
    done

    newSource="${prefix}/$(basename "${path}")"

    cp "${path}" "${newSource}"
    rm "${path}"
    ln -s "${newSource}" "${path}"

    exit
fi

# ------------------------------------------------------------------------------
# Edit subcommand
# ------------------------------------------------------------------------------

if [[ "${1}" == "edit" ]]; then
    if [[ "${2}" == "-h" || "${2}" == "--help" ]]; then
        displayEditUsageAndExit
    fi

    "${dotfilesDirectory}/bin/edit" "${dotfilesDirectory}"
    exit
fi

# ------------------------------------------------------------------------------
# Git subcommand
# ------------------------------------------------------------------------------

if [[ "${1}" == "git" ]]; then
    if [[ "${2}" == "-h" || "${2}" == "--help" ]]; then
        displayGitUsageAndExit
    fi

    shift
    git -C "${dotfilesDirectory}" "${@}"
    exit
fi

# ------------------------------------------------------------------------------
# Sync subcommand
# ------------------------------------------------------------------------------

runSync() {
    brewfile="${dotfilesDirectory}/system/Brewfile"

    echo "Updating dotfiles..."
    git -C "${dotfilesDirectory}" pull --ff-only --autostash

    echo ""
    echo "› brew bundle install"
    brew bundle install --file="${brewfile}"

    echo ""
    echo "› brew bundle cleanup"
    brew bundle cleanup --force --zap --file="${brewfile}"

    echo ""
    success "Installed packages match the Brewfile"
    exit
}

if [[ "${1}" == "sync" ]]; then
    if [[ "${2}" == "-h" || "${2}" == "--help" ]]; then
        displaySyncUsageAndExit
    fi

    runSync
fi

# ------------------------------------------------------------------------------
# Check subcommand
# ------------------------------------------------------------------------------

runCheck() {
    local issues=0

    # --------------------------------------------------------------------------
    # Git status
    # --------------------------------------------------------------------------

    echo "${bold}Dotfiles Git Status${normal}"

    local branch
    branch="$(git -C "${dotfilesDirectory}" symbolic-ref --short HEAD 2>/dev/null || git -C "${dotfilesDirectory}" rev-parse --short HEAD 2>/dev/null || echo "unknown")"

    local uncommitted
    uncommitted="$(git -C "${dotfilesDirectory}" status --porcelain 2>/dev/null || true)"

    if [[ -z "${uncommitted}" ]]; then
        success "Git working tree is clean (${branch})"
    else
        issues=$((issues + 1))
        fail "Git working tree has uncommitted changes (${branch})"
        git -C "${dotfilesDirectory}" status --short 2>/dev/null | sed 's/^/    /' || true
    fi

    local upstream
    upstream="$(git -C "${dotfilesDirectory}" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || true)"

    if [[ -n "${upstream}" ]]; then
        local behind ahead
        behind="$(git -C "${dotfilesDirectory}" rev-list --count "@{upstream}" ^HEAD 2>/dev/null || echo 0)"
        ahead="$(git -C "${dotfilesDirectory}" rev-list --count HEAD ^"@{upstream}" 2>/dev/null || echo 0)"

        if [[ "${behind}" -gt 0 ]]; then
            issues=$((issues + 1))
            fail "Branch is behind ${upstream} by ${behind} commit(s) (run \`dotfiles sync\` or \`git pull\`)"
        fi

        if [[ "${ahead}" -gt 0 ]]; then
            info "Branch is ahead of ${upstream} by ${ahead} commit(s) (unpushed)"
        fi

        if [[ "${behind}" -eq 0 && "${ahead}" -eq 0 ]]; then
            success "Branch is up to date with ${upstream}"
        fi
    else
        info "No upstream tracking branch configured for ${branch}"
    fi

    local stashCount
    stashCount="$(git -C "${dotfilesDirectory}" rev-list --walk-reflogs --count refs/stash 2>/dev/null || echo 0)"
    if [[ "${stashCount}" -gt 0 ]]; then
        info "Git has ${stashCount} stash(es)"
    fi

    # --------------------------------------------------------------------------
    # Installed packages
    # --------------------------------------------------------------------------

    echo ""
    echo "${bold}Installed Packages${normal}"

    local brewfile="${dotfilesDirectory}/system/Brewfile"

    if ! command -v brew > /dev/null 2>&1; then
        issues=$((issues + 1))
        fail "Homebrew is not installed"
    elif [[ ! -f "${brewfile}" ]]; then
        issues=$((issues + 1))
        fail "Brewfile not found at ${brewfile}"
    else
        local brewCheckOutput
        if brewCheckOutput="$(brew bundle check --file="${brewfile}" 2>&1)"; then
            local cleanupOutput
            cleanupOutput="$(brew bundle cleanup --file="${brewfile}" < /dev/null 2>&1 || true)"
            if [[ -z "${cleanupOutput}" ]]; then
                success "Installed packages match the Brewfile"
            else
                issues=$((issues + 1))
                fail "Extra packages are installed that are not in the Brewfile (run \`dotfiles sync\` to clean up)"
                echo "${cleanupOutput}" | sed 's/^/    /'
            fi
        else
            issues=$((issues + 1))
            fail "Brewfile dependencies are not satisfied (run \`dotfiles sync\` to sync packages)"
            if [[ -n "${brewCheckOutput}" ]]; then
                echo "${brewCheckOutput}" | sed 's/^/    /'
            fi
        fi
    fi

    # --------------------------------------------------------------------------
    # Symlinks
    # --------------------------------------------------------------------------

    echo ""
    echo "${bold}Symlinks${normal}"

    local symlinksChecked=0
    local symlinksOk=0
    local symlinksFailed=0

    checkSingleSymlink() {
        local src="${1}"
        local dst="${2}"
        symlinksChecked=$((symlinksChecked + 1))

        if [[ -L "${dst}" ]]; then
            local currentTarget
            currentTarget="$(readlink "${dst}" 2>/dev/null || true)"
            if [[ "${currentTarget}" == "${src}" ]] || [[ -e "${dst}" && "$(realpath "${dst}" 2>/dev/null || true)" == "$(realpath "${src}" 2>/dev/null || true)" ]]; then
                symlinksOk=$((symlinksOk + 1))
            else
                symlinksFailed=$((symlinksFailed + 1))
                fail "${dst} -> ${currentTarget} (expected ${src})"
            fi
        elif [[ -e "${dst}" ]]; then
            symlinksFailed=$((symlinksFailed + 1))
            fail "${dst} exists but is not a symlink (expected -> ${src})"
        else
            symlinksFailed=$((symlinksFailed + 1))
            fail "${dst} is missing (expected -> ${src})"
        fi
    }

    # 1. Check ~/.dotfiles symlink
    checkSingleSymlink "${dotfilesDirectory}" "${HOME}/.dotfiles"

    # 2. Check top-level *.symlink files
    while IFS= read -r -u 3 -d ""; do
        checkSingleSymlink "${REPLY}" "${HOME}/.$(basename "${REPLY%.*}")"
    done 3< <(find -H "${dotfilesDirectory}" -maxdepth 2 -name '*.symlink' -not -path '*.git*' -not -path '*.symlinkParent*' -print0 2>/dev/null)

    # 3. Check *.symlinkParent directories and nested *.symlink files
    checkSymlinksFromParent() {
        local sourceDirectory="${1}"
        local destinationDirectory="${2}"

        while IFS= read -r -u 3 -d ""; do
            checkSingleSymlink "${REPLY}" "${destinationDirectory}/$(basename "${REPLY%.*}")"
        done 3< <(find -H "${sourceDirectory}" -maxdepth 1 -name '*.symlink' -not -path '*.git*' -print0 2>/dev/null)

        while IFS= read -r -u 3 -d ""; do
            checkSymlinksFromParent "${REPLY}" "${destinationDirectory}/$(basename "${REPLY%.*}")"
        done 3< <(find -H "${sourceDirectory}" -maxdepth 1 -name '*.symlinkParent' -not -path '*.git*' -not -path "${sourceDirectory}" -print0 2>/dev/null)
    }

    while IFS= read -r -u 3 -d ""; do
        checkSymlinksFromParent "${REPLY}" "${HOME}/.$(basename "${REPLY%.*}")"
    done 3< <(find -H "${dotfilesDirectory}" -maxdepth 2 -name '*.symlinkParent' -not -path '*.git*' -print0 2>/dev/null)

    # 4. Check LaunchAgents on macOS
    if [[ "$(uname -s)" == "Darwin" && -d "${dotfilesDirectory}/macos/LaunchAgents" ]]; then
        while IFS= read -r -u 3 -d ""; do
            checkSingleSymlink "${REPLY}" "${HOME}/Library/LaunchAgents/$(basename "${REPLY}")"
        done 3< <(find -H "${dotfilesDirectory}/macos/LaunchAgents" -maxdepth 1 -name '*.plist' -print0 2>/dev/null)
    fi

    # 5. Check for broken symlinks in $HOME pointing into dotfiles
    while IFS= read -r -u 3 -d ""; do
        local target
        target="$(readlink "${REPLY}" 2>/dev/null || true)"
        if [[ "${target}" == "${dotfilesDirectory}"* && ! -e "${REPLY}" ]]; then
            symlinksFailed=$((symlinksFailed + 1))
            fail "Broken symlink: ${REPLY} points to missing ${target}"
        fi
    done 3< <(find "${HOME}" -maxdepth 2 -type l ! -exec test -e {} \; -print0 2>/dev/null)

    if [[ "${symlinksFailed}" -eq 0 ]]; then
        success "All symlinks are correctly linked (${symlinksOk} checked)"
    else
        issues=$((issues + symlinksFailed))
        fail "${symlinksFailed} of ${symlinksChecked} symlinks are missing or incorrect (run \`dotfiles --link\` to fix)"
    fi

    # --------------------------------------------------------------------------
    # Key dotfiles status
    # --------------------------------------------------------------------------

    echo ""
    echo "${bold}Key Status${normal}"

    # Default shell
    local currentShell
    currentShell="$(basename "${SHELL:-}")"
    if [[ "${currentShell}" == "zsh" ]]; then
        success "Default shell is zsh"
    else
        issues=$((issues + 1))
        fail "Default shell is ${currentShell:-unknown} (expected zsh)"
    fi

    # --------------------------------------------------------------------------
    # Summary
    # --------------------------------------------------------------------------

    echo ""
    if [[ "${issues}" -eq 0 ]]; then
        success "All dotfiles checks passed!"
        exit 0
    else
        fail "${issues} issue(s) found with dotfiles"
        exit 1
    fi
}

if [[ "${1}" == "check" ]]; then
    if [[ "${2}" == "-h" || "${2}" == "--help" ]]; then
        displayCheckUsageAndExit
    fi

    runCheck
fi

# ------------------------------------------------------------------------------
# Default (no) subcommand
# ------------------------------------------------------------------------------

if test $# -eq 0; then
	runCheck
fi

defaults="false"
link="false"
install="false"
guiSudoAskpass="true"

while test $# -gt 0; do
	case "$1" in
		"-c"|"--command-line-sudo-askpass")
			guiSudoAskpass="false"
			;;
		"-d"|"--defaults")
			defaults="true"
			;;
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-i"|"--install")
			install="true"
			;;
		"-l"|"--link")
			link="true"
			;;
		*)
			echo "Invalid option: ${1}"
			displayUsageAndExit
			;;
	esac
	shift
done

atExit() {
	if [ ! -z "${AT_EXIT}" ]; then
		AT_EXIT+=';'
	fi

	AT_EXIT+="${*}"
	trap "${AT_EXIT}" EXIT
}

# ------------------------------------------------------------------------------
# Check for updates
# ------------------------------------------------------------------------------

pushd "${dotfilesDirectory}" > /dev/null
echo "Updating dotfiles..."

git pull --ff-only --autostash
popd > /dev/null

# ------------------------------------------------------------------------------
# Set up GUI password dialog for sudo, if specified
# ------------------------------------------------------------------------------

if [ "${guiSudoAskpass}" == "true" ]; then
	sudoGuiAskpassScript="$(mktemp)"

	deleteSudoAskpassScript() {
		/bin/rm -f "${sudoGuiAskpassScript}"
	}

	atExit deleteSudoAskpassScript

	cat<<-'EOF' > "${sudoGuiAskpassScript}"
	#!/bin/bash
	password="$(osascript -e 'Tell application "System Events" to display dialog "dotfiles is requesting your administrator password:" default answer "" with hidden answer' -e 'text returned of result' 2> /dev/null)"
	echo "$password"
	EOF

	chmod +x "${sudoGuiAskpassScript}"
	export SUDO_ASKPASS="${sudoGuiAskpassScript}"
fi

# ------------------------------------------------------------------------------
# Set defaults
# ------------------------------------------------------------------------------

if [ "${defaults}" == "true" ]; then
	echo ""
	echo "Setting defaults..."

	# Set macOS defaults
	"${dotfilesDirectory}"/macos/set-defaults.sh

	if [ "$(basename "${SHELL}")" != "zsh" ]; then
		echo "Setting Zsh as the default shell"
		if chsh -s $(which zsh); then
			success "Zsh set as the default"
		else
			fail "Error setting zsh as the default shell"
			exit 1
		fi
	fi

	echo "Defaults set!"
fi

# ------------------------------------------------------------------------------
# Link dotfiles
# ------------------------------------------------------------------------------

if [ "${link}" == "true" ]; then
	echo ""
	echo "Linking dotfiles..."
	"${dotfilesDirectory}"/system/link.sh
fi

# ------------------------------------------------------------------------------
# Install dependencies
# ------------------------------------------------------------------------------

if [ "${install}" == "true" ]; then
	echo ""
	echo "Installing dependencies..."
	"${dotfilesDirectory}"/system/install.sh
fi

# ------------------------------------------------------------------------------
# Backup Atom packages
# ------------------------------------------------------------------------------

# TODO: check if Atom has just been freshly installed, and install packages in that case, instead
"${dotfilesDirectory}"/bin/atom-package-backup
